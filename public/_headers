# Plugin workers: no network unless the plugin has the `network` permission,
# no scripts other than the plugin's own module, and no workers of its own. Mirrors vite.config.ts.
/assets/runtime-*
  Content-Security-Policy: default-src 'none'; script-src 'self' blob:; worker-src 'none'; connect-src 'none'

/assets/net-runtime-*
  Content-Security-Policy: default-src 'none'; script-src 'self' blob:; worker-src 'none'; connect-src 'self' https: wss:

# The built platform scripts (the kernel, the plugin runtimes) have their content's hash in their
# names, so a file at one of these addresses never changes: browsers keep it without asking again.
# Without this every plugin worker asked the server about the same runtime file, and the browser
# sends those questions about one address one after another, so a page with twenty plugins waited
# for twenty round trips before its first view.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Every page (an app's app.html, a folder's index.html, the front page, any other .html):
#
# - Scripts only from this site's files: no inline script (inline speculation rules aside), and
#   none from other sites but Cloudflare's Web Analytics beacon, which Cloudflare adds to pages.
# - Trusted Types: markup, script text and script addresses reach the page only through the named
#   policies (src/host/trusted.ts, elements/mermaid.js, and the DOMPurify that Mermaid in vendor/
#   brings), so nothing a plugin sends can become script.
# - Frames only of this site's own pages (an app made in the browser, in its preview) and of a server on
#   the person's own device, by loopback address (the Markdown editor's Hugo preview,
#   elements/ui-site-preview.js): no page here, and nothing a plugin draws, can put another site in a frame.
# - Permissions-Policy: the device features no app here uses are off, for the page and anything it
#   embeds; the ones apps use stay on for this site.
#
# tests/checks/page-policy.mjs checks every host sends these, and the test run fails on any page
# that breaks them. Keep the four rules the same: Cloudflare sends /demos/habits/app.html on to
# /demos/habits/app, so the /*/app rule is the app pages there.
/
  Content-Security-Policy: script-src 'self' blob: 'inline-speculation-rules' https://static.cloudflareinsights.com; object-src 'none'; base-uri 'self'; frame-src 'self' http://localhost:* http://*.localhost:* http://127.0.0.1:* https://localhost:* https://*.localhost:* https://127.0.0.1:*; frame-ancestors 'self'; form-action 'self'; require-trusted-types-for 'script'; trusted-types platform default mermaid dompurify
  Permissions-Policy: accelerometer=(), autoplay=(self), bluetooth=(), camera=(), clipboard-write=(self), display-capture=(), fullscreen=(self), gamepad=(self), geolocation=(), gyroscope=(), hid=(), magnetometer=(), microphone=(self), midi=(), payment=(), publickey-credentials-create=(self), publickey-credentials-get=(self), screen-wake-lock=(self), serial=(), usb=(), web-share=(self), xr-spatial-tracking=()
  X-Content-Type-Options: nosniff

