{
  "name": "extensible-web-apps",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:server": "vite build -c vite.server.config.ts",
    "check": "node scripts/check.mjs",
    "new-app": "node scripts/new-app.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "serve": "npm run build && npm run build:server && node --no-warnings src/server/serve.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.space.json",
    "test:seams": "node --no-warnings tests/seams/run.mjs",
    "test:server": "npm run build && npm run build:server && node --no-warnings tests/server/run.mjs",
    "test": "npm run build && node tests/platform.test.mjs",
    "reference": "vite build && node scripts/reference.mjs"
  },
  "dependencies": {
    "cordis": "4.0.0-rc.11"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "5.8.3",
    "vite": "6.4.5"
  }
}
