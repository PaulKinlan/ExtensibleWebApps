// A space's kernel entries (src/server/space.ts for Node, and
// src/server/cloudflare/kernel.ts): the browser's kernel with a server around
// it, so they are checked with the browser's types and Node's.
{
  "extends": "./tsconfig.json",
  "compilerOptions": { "types": ["vite/client", "node"] },
  "include": ["src/server/space.ts", "src/server/space-env.ts", "src/server/isolate.ts", "src/server/cloudflare/kernel.ts", "src/server/cloudflare/isolate.ts", "src/seams/remote-isolates.ts", "src/server/cloudflare/durable-object.d.ts", "src/kernel/kernel-modules.d.ts"],
  "exclude": []
}
