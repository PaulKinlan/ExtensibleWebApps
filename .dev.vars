# Read by `npx wrangler dev` on this machine only, in place of the same names in wrangler.jsonc. No secrets here.
# The live site signs in with GitHub and Bluesky (AUTH_PROVIDERS in wrangler.jsonc), and GitHub needs the
# Worker's secret, which this machine hasn't got: so here, sign-in is passkeys only. To try a provider
# locally, list it here and give its secret on the next line (GITHUB_CLIENT_SECRET=...), uncommitted.
AUTH_PROVIDERS=[]
