// Cloudflare hosting: the built app served as Workers static assets, and a
// Worker (src/server/cloudflare/worker.ts) that runs a kernel for each space a
// client joins, at /s/<space>/kernel (docs/server.md). An address with no
// file gets 404.html, which starts the service worker and loads the address
// again through it, so a link to an app's screen (/demos/reading-list/book/42)
// opens on a first visit too. Cloudflare applies public/_headers (copied into
// dist/), so plugin workers get their content security policy here as they do
// under `vite preview`.
//
// Each space is a Durable Object, `Space`, which loads the space's kernel as a
// Dynamic Worker (the LOADER binding) and runs it as a facet, with its own
// SQLite database for the space's folder. Accounts and sign-in (/auth/) live
// in one more Durable Object, `Accounts`, with its own database.
//
// Deploys come from Cloudflare's Git integration (Workers Builds): build
// command `npm run build` (which builds the space kernel too), deploy command
// `npx wrangler deploy`. Branches other than main deploy with
// `npx wrangler preview`, which needs the (empty) `previews` block below.
{
  "name": "extensible-web-apps",
  "main": "src/server/cloudflare/worker.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "durable_objects": {
    "bindings": [
      { "name": "SPACE", "class_name": "Space" },
      { "name": "ACCOUNTS", "class_name": "Accounts" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Space"] },
    { "tag": "v2", "new_sqlite_classes": ["Accounts"] }
  ],
  "worker_loaders": [{ "binding": "LOADER" }],
  // Cloudflare Email Service, for mail server plugins send to a space's members (std/email/module.ts).
  // extensibleweb.app is onboarded for Email Sending, and EMAIL_FROM below is the address on it that mail
  // comes from (docs/server.md). Without EMAIL_FROM, mail stays in each space's outbox. `wrangler dev`
  // only logs what it would send. The tests set their own EMAIL_FROM with --var.
  "send_email": [{ "name": "EMAIL" }],
  // Plain settings, kept in Git so a deploy doesn't drop them. keep_vars leaves any other variable set in
  // the dashboard alone; secrets (OAuth client secrets) are never in this file.
  //
  // AUTH_PROVIDERS is who people can sign in with on extensibleweb.app besides a passkey (docs/server.md).
  // GitHub's client id is public; its secret is the Worker secret GITHUB_CLIENT_SECRET, set in the
  // dashboard or with `npx wrangler secret put GITHUB_CLIENT_SECRET`, and a deploy leaves secrets alone.
  // Bluesky needs no id or secret. A Worker with this list and no secret doesn't start its accounts, on
  // purpose, so: `wrangler dev` reads .env, which turns the list off on this machine, and a Worker
  // for one app (scripts/deploy-app.mjs) leaves the list out, since its sign-in would need its own OAuth app.
  "vars": {
    "AUTH_PROVIDERS": "[{\"id\":\"github\",\"clientId\":\"Ov23liBsAoR2YWkZcYfZ\"},{\"id\":\"bluesky\"}]",
    "EMAIL_FROM": "paul@extensibleweb.app"
  },
  "keep_vars": true,
  "previews": {}
}
