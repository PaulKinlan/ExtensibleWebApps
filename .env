# Defaults for `npx wrangler dev` on this machine, in place of the same names in wrangler.jsonc.
# THIS FILE IS IN GIT: NEVER PUT A SECRET HERE. Secrets go in .env.local, which Git ignores.
#
# The live site signs in with GitHub and Bluesky (AUTH_PROVIDERS in wrangler.jsonc), and GitHub needs the
# Worker's secret, which this machine hasn't got. So here the list is empty: sign-in is passkeys only.
# To try a provider on this machine, make .env.local beside this file with, say:
#   AUTH_PROVIDERS=[{"id":"github","clientId":"..."}]
#   GITHUB_CLIENT_SECRET=...
AUTH_PROVIDERS=[]
